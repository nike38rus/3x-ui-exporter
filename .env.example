# Copy to .env and supply a panel API token (must have Administrator scope). Never commit .env.
XUI_API_TOKEN=replace-with-your-panel-api-token
XRAY_CONTAINER=3xui_app
XUI_URL=http://127.0.0.1:2053
XRAY_API=127.0.0.1:62789
# Leave empty to discover metrics.listen from current panel settings.
XRAY_METRICS_URL=
EXPORTER_VERSION=1.0.0
# Optional: set to true to export individual user/client traffic counters from Xray.
COLLECT_CLIENT_STATS=false
# Optional: set to true to skip TLS certificate verification for 3x-ui panel requests.
XUI_INSECURE_SKIP_VERIFY=false

# Optional HTTP Server Security (Basic Auth / Bearer Token / TLS / mTLS)
# WEB_BASIC_AUTH_USERNAME=
# WEB_BASIC_AUTH_PASSWORD=
# WEB_BASIC_AUTH_PASSWORD_FILE=
# WEB_BEARER_TOKEN=
# WEB_BEARER_TOKEN_FILE=
# WEB_AUTH_HEALTHZ=false
# WEB_TLS_CERT_FILE=
# WEB_TLS_KEY_FILE=
# WEB_TLS_CLIENT_CA_FILE=
