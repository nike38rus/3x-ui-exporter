# Copy to .env and supply a panel API token. Never commit .env.
XUI_API_TOKEN=replace-with-your-panel-api-token
XRAY_CONTAINER=3xui_app
XUI_URL=http://127.0.0.1:2053
XRAY_API=127.0.0.1:62789
# Leave empty to discover metrics.listen from current panel settings.
XRAY_METRICS_URL=
EXPORTER_VERSION=0.6.0
# Optional: set to true to export Prometheus process and Go runtime metrics for the exporter itself.
INCLUDE_EXPORTER_METRICS=false
# Optional: set to true to export individual user/client traffic counters from Xray.
COLLECT_CLIENT_STATS=false
