# Copy to .env and adjust variables to match your environment.

# Supply your 3x-ui API Token (generate in 3x-ui: Panel Settings -> API Token with Administrator scope):
XUI_API_TOKEN=your-panel-api-token-here

EXPORTER_VERSION=1.4.1
LOG_LEVEL=info

# Optional credentials for Grafana login (default: admin / admin):
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Optional HTTP Server Security (Basic Auth / Bearer Token / TLS / mTLS)
# WEB_BASIC_AUTH_USERNAME=
# WEB_BASIC_AUTH_PASSWORD=
# WEB_BEARER_TOKEN=
# WEB_AUTH_HEALTHZ=false
# WEB_TLS_CERT_FILE=
# WEB_TLS_KEY_FILE=
# WEB_TLS_CLIENT_CA_FILE=
