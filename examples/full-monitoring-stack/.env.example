# Copy to .env and adjust variables to match your environment.
XUI_API_TOKEN=your-panel-api-token-here

# Panel and Xray API endpoints:
# - If 3x-ui runs in another container on the same docker network: http://3x-ui:2053
# - If 3x-ui runs directly on the host: http://host.docker.internal:2053 (or LAN IP)
XUI_URL=http://3x-ui:2053
XRAY_API=3x-ui:62789

# Leave empty to discover metrics endpoint from panel settings automatically.
XRAY_METRICS_URL=

EXPORTER_VERSION=0.7.0
LOG_LEVEL=info

# Optional credentials for Grafana login (default: admin / admin)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
